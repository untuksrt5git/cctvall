# Hik-Connect account used by CloudCam. Keep this file private.
CLOUDCAM_PLATFORM=hikconnect
CLOUDCAM_EMAIL=your-hik-connect-email@example.com
CLOUDCAM_PASSWORD=replace-with-your-own-password
CLOUDCAM_LANG=en

# Create random values with at least 24 characters (32+ recommended).
CLOUDCAM_BRIDGE_TOKEN=replace-with-a-long-random-api-token

# Read-only credentials used by the RTSP stream server.
CLOUDCAM_STREAM_USER=cctvviewer
CLOUDCAM_STREAM_PASSWORD=replace-with-a-different-long-password

# IP address or DNS name of the PC/server running Docker, reachable by the phone/TV Box.
CLOUDCAM_STREAM_HOST=192.168.1.20
